# Copy this file to .env.local and set the values.
# Do not commit real values. See docs/DEPLOY_GUIDE.md, section 3.

# Public: the browser receives these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: do not add a NEXT_PUBLIC_ prefix to these names.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
RATE_LIMIT_SECRET=

# Optional: interview request rate limit. Defaults: 3 requests in 60 minutes.
INTERVIEW_RATE_LIMIT_MAX=
INTERVIEW_RATE_LIMIT_WINDOW_MINUTES=
